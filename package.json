  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "rabbit:up": "docker compose up -d rabbitmq",
    "rabbit:down": "docker compose stop rabbitmq",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "tsx src/entrypoints/migrate.ts",
    "start": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
