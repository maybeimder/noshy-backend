{
  "name": "@noshy/backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/entrypoints/api.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/infrastructure/database/postgres/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/infrastructure/database/seed/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "worker": "node --env-file-if-exists=.env dist/entrypoints/worker.js",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/entrypoints/worker.ts",
    "infra:up": "docker compose up -d postgres rabbitmq",
    "infra:down": "docker compose stop postgres rabbitmq",
    "db:up": "docker compose up -d postgres",
    "test:rabbit": "TEST_EVENT_TRANSPORT=rabbitmq vitest run",
    "events:replay": "tsx --env-file-if-exists=.env src/entrypoints/replay-events.ts",
    "recipes:import": "tsx --env-file-if-exists=.env src/entrypoints/import-recipes.ts",
    "rabbit:up": "docker compose up -d rabbitmq",
    "rabbit:down": "docker compose stop rabbitmq"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@node-rs/argon2": "^2.2.2",
    "amqplib": "^2.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "mongodb": "^7.9.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
