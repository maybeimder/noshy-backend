# Copia este archivo a .env. La API, el worker y los scripts lo cargan al arrancar.
# Con Docker (docker compose up), DATABASE_URL, RABBITMQ_URL y STORAGE_DIR los pone el compose. MONGO_URL siempre sale de aquí.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL pública de la API: firma las subidas de fotos y arma sus enlaces. En el servidor NO puede ser localhost (ej. https://api.midominio.com).
PUBLIC_BASE_URL=http://localhost:3000
SHARE_BASE_URL=https://noshy.app

# Postgres local con `pnpm infra:up` (puerto del docker-compose)
DATABASE_URL=postgres://noshy:noshy@localhost:5433/noshy
# Mongo del homelab (no va en el compose). La base es la de la URL (`/food`); MONGO_DB la cambia.
MONGO_URL=mongodb://usuario:clave@192.168.1.10:27017/food?authSource=food
# MONGO_DB=food
# Base del catálogo de alimentos (products_slim), de solo lectura. El usuario de MONGO_URL necesita rol `read` sobre ella.
# MONGO_FOOD_DB=food

# Firma de access tokens (HS256). OBLIGATORIO y de 32+ caracteres; si cambia, se cierran las sesiones.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OAuth: client IDs aceptados como audience del idToken (separados por coma)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Chef con IA (OpenRouter). Sin la key, el chef usa el motor de reglas.
# CHEF_ENGINE=openrouter            # rules | openrouter (por defecto: openrouter si hay key)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,inclusionai/ling-3.2-flash:free,openrouter/free   # se prueban en orden

# Archivos (facturas, fotos, exportaciones). local guarda en STORAGE_DIR y firma URLs propias.
STORAGE_DRIVER=local
STORAGE_DIR=./.storage
UPLOAD_SIGNING_SECRET=change-me-too

# Facturas: mock devuelve una factura de ejemplo; none las marca como ilegibles.
RECEIPT_PARSER=mock

# Eventos (event store + outbox en Postgres → RabbitMQ → observers).
# Con RABBITMQ_URL el transporte es RabbitMQ; sin ella, los eventos se entregan dentro del proceso.
RABBITMQ_URL=amqp://noshy:noshy@localhost:5672
# RABBITMQ_PREFIX=noshy                         # noshy.events, noshy.events.observers, noshy.dlx, noshy.dead-letters
# RABBITMQ_PREFETCH=20
# RABBITMQ_RETRY_DELAYS_MS=5000,30000,120000,600000   # esperas entre reintentos; después, dead letters
# EVENT_TRANSPORT=in-process                    # fuerza el modo sin broker
# Credenciales del contenedor rabbitmq del compose
# RABBITMQ_USER=noshy
# RABBITMQ_PASSWORD=noshy

# true: este proceso también consume eventos y corre el scheduler (pnpm dev sin worker aparte).
# En Docker es false en la API y el contenedor `worker` hace ese trabajo.
RUN_WORKERS=true
OUTBOX_POLL_MS=500
OUTBOX_MAX_ATTEMPTS=10
RATE_LIMIT_ENABLED=true

# Arranque: aplica migraciones y carga el catálogo si la base está vacía.
MIGRATE_ON_START=true
SEED_ON_START=true
