PORT=3000
# CORS: por defecto "*" (cualquier origen). Útil en desarrollo cuando la IP del frontend cambia.
# CORS_ORIGIN=*

# --- Infraestructura (solo con `pnpm dev` en tu máquina; con `docker compose up -d` se configuran solas) ---
# Opcional. Sin esta variable todo corre en memoria dentro de la API (sin worker).
# RABBITMQ_URL=amqp://noshy:noshy@localhost:5672
# Opcional. Postgres del docker-compose (puerto 5433 para no chocar con un Postgres local en 5432).
# DATABASE_URL=postgres://noshy:noshy@localhost:5433/noshy

# --- Credenciales de los contenedores (docker-compose). Cámbialas en un server. ---
# POSTGRES_PASSWORD=noshy
# RABBITMQ_USER=noshy
# RABBITMQ_PASSWORD=noshy
# Puerto e interfaz del host donde docker compose publica la API.
# 127.0.0.1 = solo el propio server (detrás de Nginx / web-deploy). 0.0.0.0 = toda la red local.
# API_PORT=3000
# API_BIND=127.0.0.1

# --- Auth ---
# Secreto de los JWT (>= 32 caracteres). Sin él, los tokens dejan de valer cada vez que reinicia la API.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# --- Agente chef con OpenRouter (modelos gratuitos). Key en https://openrouter.ai/keys ---
# OPENROUTER_API_KEY=
# Opcional: modelos separados por coma (el primero es el preferido, el resto respaldo).
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,openrouter/free
