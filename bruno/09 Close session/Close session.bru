meta {
  name: Close session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/chef/sessions/{{sessionId}}/close
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "manual",
    "preferencesMarkdown": "# Preferencias\n- Sin gluten\n- No le gusta el brócoli\n"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
