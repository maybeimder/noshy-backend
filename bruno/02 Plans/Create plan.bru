}

post {
  url: {{baseUrl}}/plans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "objective": "maintain",
    "targets": {
      "calories": 2000,
      "proteinGrams": 120
    },
    "restrictions": [
      "sin gluten"
    ],
    "mealsPerDay": 4
  }
}

