meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.getBody().token);
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
